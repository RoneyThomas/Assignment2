    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-jwt": "^8.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
