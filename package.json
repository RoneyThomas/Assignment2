{
  "name": "myportfolio",
  "version": "1.0.0",
  "description": "COMP229 Assignment 2 - Portfolio REST API (Node, Express, MongoDB)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
